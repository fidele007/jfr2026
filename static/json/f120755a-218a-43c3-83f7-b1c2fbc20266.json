{"data": {"event": {"id": "f120755a-218a-43c3-83f7-b1c2fbc20266", "picture": null, "sessionType": "S\u00e9ance p\u00e9dagogique", "sessionTypeColor": "#44bdfa", "voting": null, "title": "Myomes et ad\u00e9nomyose : corr\u00e9lation radio-anatomopathologique et implications th\u00e9rapeutiques", "start": "2026-10-09T17:45+02:00", "end": "2026-10-09T18:45+02:00", "objectives": ["<div>Savoir&nbsp; caract\u00e9riser et Identifier les crit\u00e8res diagnostiques IRM des myomes et de l'ad\u00e9nomyose en les corr\u00e9lant aux donn\u00e9es anatomopathologiques, afin d'\u00e9tablir un compte-rendu standardis\u00e9 orientant la prise en charge.<span style=\"white-space:pre\"> </span></div>", "<div>&nbsp;D\u00e9terminer, \u00e0 partir du ph\u00e9notype radiologique, l'option th\u00e9rapeutique la plus adapt\u00e9e \u2014 traitement m\u00e9dical, chirurgie conservatrice ou radicale \u2014 en int\u00e9grant le projet de fertilit\u00e9 et les comorbidit\u00e9s de la patiente.<span style=\"white-space:pre\"> </span></div>", "<div>&nbsp;Pr\u00e9ciser les indications, les r\u00e9sultats et les limites des techniques de radiologie interventionnelle comme alternatives au traitement m\u00e9dical et chirurgical et savoir les positionner dans la discussion multidisciplinaire<span style=\"white-space:pre\"> </span></div>"], "onAir": null, "vod": {"checkPermissions": ["media:view"], "media": null}, "broadcasts": {"items": []}, "room": {"id": "046f4661-a25c-4a4b-a7bf-242d67d56d95", "name": "Amphith\u00e9\u00e2tre Havane", "type": "ROOM"}, "schedule": {"items": [{"id": "e9a93751-f757-458d-8027-09c33d012f64", "title": "Myome et Ad\u00e9nomyose : corr\u00e9lation radio-histologique - le radiologue en premi\u00e8re ligne", "start": "2026-10-09T17:45+02:00", "end": "2026-10-09T17:57+02:00", "element": {"abstract": null}, "speakers": {"items": [{"id": "d357f775-3d1d-4e52-94ed-d50d23baf7a2", "lastName": "Florin", "firstName": "Marie", "roles": [{"name": "speaker"}], "photo": {"url": "https://ser