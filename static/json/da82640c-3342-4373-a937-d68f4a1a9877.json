{"data": {"event": {"id": "da82640c-3342-4373-a937-d68f4a1a9877", "picture": "https://services.medicalcongress.online/congress/medias/2026/JFR2026/1250/video/thumbs/poster.jpg", "sessionType": "S\u00e9ance p\u00e9dagogique", "sessionTypeColor": "#44bdfa", "voting": null, "title": "Imagerie du cancer en 2026 : l\u2019essor de l\u2019intelligence artificielle", "start": "2026-10-11T10:00+02:00", "end": "2026-10-11T11:00+02:00", "objectives": ["<p>Cette session explorera l\u2019impact croissant de l\u2019intelligence artificielle en imagerie canc\u00e9rologique, depuis le d\u00e9veloppement des algorithmes jusqu\u2019\u00e0 leurs applications cliniques concr\u00e8tes. Les intervenants aborderont le r\u00f4le des data challenges dans l\u2019innovation en IA appliqu\u00e9e aux cancers de l\u2019ovaire et du pancr\u00e9as, les perspectives d\u2019automatisation de l\u2019\u00e9valuation tumorale avec l\u2019AI RECIST, ainsi que les avanc\u00e9es de l\u2019IA dans la d\u00e9tection des l\u00e9sions incidentales en oncologie.<br>", "\u00c0 travers ces pr\u00e9sentations, la session mettra en lumi\u00e8re les opportunit\u00e9s, les limites et les enjeux futurs de l\u2019int\u00e9gration de l\u2019IA dans la pratique quotidienne de l\u2019imagerie du cancer.</p>"], "onAir": null, "vod": {"checkPermissions": ["media:view"], "media": null}, "broadcasts": {"items": []}, "room": {"id": "ebf50ec9-334c-4ebb-8f92-96534526f129", "name": "Forum IA", "type": "ROOM"}, "schedule": {"items": [{"id": "92774b1c-708a-491b-9e93-6d2d3ec07bf2", "title": "L\u2019IA en radiologie interventionnelle oncologique", "start": "2026-10-11T10:00+02:00", "end": "2026-10-11T10:15+02:00", "element": {"abstract": null}, "speakers": {"items": [{"id": "b9b6435f-afe2-45de-9fdc-11249c05ef5e", "lastName": "Boeken", "firstName": "Tom", "roles": [{"name": "speaker"}], "photo": {"url": "https://services.y-congress.com/congress/wspreview/getphoto.aspx?idPhoto=236381&t=1"}, "country": {"name": "France"}, "city": {"nam