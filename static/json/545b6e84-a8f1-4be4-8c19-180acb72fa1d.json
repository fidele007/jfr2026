{"data": {"event": {"id": "545b6e84-a8f1-4be4-8c19-180acb72fa1d", "picture": "https://services.medicalcongress.online/congress/medias/2026/JFR2026/988/video/thumbs/poster.jpg", "sessionType": "S\u00e9ances de cours", "sessionTypeColor": "#6545fa", "voting": null, "title": "Syndromes compressifs veineux et embolisation pelvienne:\u00a0 Nut cracker : diagnostic et prise en charge", "start": "2026-10-10T09:30+02:00", "end": "2026-10-10T10:30+02:00", "objectives": ["<p data-path-to-node=\"9,0,0\">Savoir identifier les <b data-index-in-node=\"22\" data-path-to-node=\"9,0,0\">signes directs et indirects</b> en imagerie (\u00e9cho-Doppler, scanner, IRM).</p>", "<p data-path-to-node=\"9,1,0\">Comprendre la corr\u00e9lation indispensable entre les <b data-index-in-node=\"50\" data-path-to-node=\"9,1,0\">donn\u00e9es anatomiques</b> et la <b data-index-in-node=\"76\" data-path-to-node=\"9,1,0\">clinique</b> (douleur pelvienne, h\u00e9maturie).</p>", "<p data-path-to-node=\"9,3,0\">Discuter la place de la <b data-index-in-node=\"24\" data-path-to-node=\"9,3,0\">radiologie interventionnelle</b>&nbsp;: abstention, embolisation des reflux, traitement de l'obstacle veineux?&nbsp;</p>"], "onAir": null, "vod": {"checkPermissions": ["media:view"], "media": null}, "broadcasts": {"items": []}, "room": {"id": "edd5429a-72c9-424d-9139-4947adc12af5", "name": "Salle Maillot", "type": "ROOM"}, "schedule": {"items": [{"id": "1a1e3906-52ee-448f-97eb-4f1af21c5a17", "title": "Prise en charge diagnostique, le role du radiologue", "start": "2026-10-10T09:30+02:00", "end": "2026-10-10T09:45+02:00", "element": {"abstract": {"id": "1A1E3906-52EE-448F-97EB-4F1AF21C5A17"}}, "speakers": {"items": [{"id": "aa1497dd-1fc8-4bfe-8908-f34ccbb84dfa", "lastName": "Wang", "firstName": "Maud", "roles": [{"name": "speaker"}], "photo": null, "country": {"name": "Belgique"}, "city": {"name": "Courtrai"}}]}, "vod": {"checkPermissions": ["media:view"], "media": {"id": "9c7c23d6-7720-4382-b22c-f687baf502d7", "type": "