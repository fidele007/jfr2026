{"data": {"event": {"id": "eebb809f-bbe1-4d79-adf2-8b4697218c63", "picture": "https://services.medicalcongress.online/congress/medias/2026/JFR2026/679/video/thumbs/poster.jpg", "sessionType": "S\u00e9ances de cours", "sessionTypeColor": "#6545fa", "voting": null, "title": "Radiologie interventionnelle en ost\u00e9o-articulaire: au-del\u00e0 de la cimentoplastie", "start": "2026-10-09T08:15+02:00", "end": "2026-10-09T09:15+02:00", "objectives": ["<p data-end=\"494\" data-start=\"303\">Ce cours a pour objectif de <strong data-end=\"435\" data-start=\"331\">mettre en lumi\u00e8re la diversit\u00e9 des applications de la radiologie interventionnelle ost\u00e9o-articulaire</strong>, souvent r\u00e9duite, \u00e0 tort, au seul geste de cimentoplastie.</p>", "<p data-end=\"774\" data-start=\"496\">\u00c0 travers une approche didactique et illustr\u00e9e par des <strong data-end=\"577\" data-start=\"551\">cas cliniques concrets</strong>, ce cours montrera que la radiologie interventionnelle joue aujourd\u2019hui un r\u00f4le central dans la prise en charge des pathologies ost\u00e9o-articulaires, et en particulier en oncologie. Les sessions seront orient\u00e9s sur d'une part les traitement ablatifs, du plus simple au plus complexe, d'autre part les techniques de consolidation osseuse percutan\u00e9es.&nbsp;</p>"], "onAir": null, "vod": {"checkPermissions": ["media:view"], "media": null}, "broadcasts": {"items": []}, "room": {"id": "628607c6-3f4e-46f9-9bdf-24778538e3f3", "name": "Amphith\u00e9\u00e2tre Bordeaux", "type": "ROOM"}, "schedule": {"items": [{"id": "977e5321-d02c-496f-be98-276366351fe4", "title": "Tumeur osseuse: d\u00e9truire sans ouvrir", "start": "2026-10-09T08:15+02:00", "end": "2026-10-09T08:35+02:00", "element": {"abstract": {"id": "977E5321-D02C-496F-BE98-276366351FE4"}}, "speakers": {"items": [{"id": "774f9fde-549d-4f99-b345-d0809357a103", "lastName": "Lefevre", "firstName": "Thomas", "roles": [{"name": "speaker"}], "photo": {"url": "https://services.y-con