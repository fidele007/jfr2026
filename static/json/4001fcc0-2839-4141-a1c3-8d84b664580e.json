{"data": {"event": {"id": "4001fcc0-2839-4141-a1c3-8d84b664580e", "picture": null, "sessionType": "S\u00e9ance p\u00e9dagogique", "sessionTypeColor": "#44bdfa", "voting": null, "title": "Des neurosciences aux th\u00e9rapies innovantes : le futur c'est maintenant !", "start": "2026-10-09T14:00+02:00", "end": "2026-10-09T15:00+02:00", "objectives": ["<p style=\"margin-top:5.0pt;margin-right:7.5pt;margin-bottom:5.0pt;margin-left:", "7.5pt\">Cette session explore les avanc\u00e9es r\u00e9centes en neurosciences translationnelles en psychiatrie et neurologie fonctionnelle. Des premiers enseignements issus de grandes cohortes aux approches de traitements guid\u00e9s par l\u2019IRM, jusqu\u2019aux th\u00e9rapies \u00e9mergentes comme le HIFU, elle met en lumi\u00e8re les perspectives offertes par l\u2019imagerie avanc\u00e9e et les traitements innovants dans la compr\u00e9hension et la modulation des dysfonctionnements des circuits c\u00e9r\u00e9braux.<o:p></o:p></p>"], "onAir": null, "vod": {"checkPermissions": ["media:view"], "media": null}, "broadcasts": {"items": []}, "room": {"id": "edd5429a-72c9-424d-9139-4947adc12af5", "name": "Salle Maillot", "type": "ROOM"}, "schedule": {"items": [{"id": "dd9baaae-d961-4e25-9fba-0a0e1dc27b10", "title": "Cohorte French Minds : premiers enseignements", "start": "2026-10-09T14:00+02:00", "end": "2026-10-09T14:15+02:00", "element": {"abstract": null}, "speakers": {"items": [{"id": "bc2a2e69-ee62-4172-a650-5045d5225eab", "lastName": "Bapst", "firstName": "Blanche", "roles": [{"name": "speaker"}], "photo": {"url": "https://services.y-congress.com/congress/wspreview/getphoto.aspx?idPhoto=234644&t=1"}, "country": {"name": "France"}, "city": {"name": "Cr\u00e9teil"}}, {"id": "1aa45cda-3eda-4f8e-9fe8-d2d5e56b1ec6", "lastName": "Laidi", "firstName": "Charles", "roles": [{"name": "speaker"}], "photo": {"url": "https://services.y-congress.com/congress/wspreview/getphoto.aspx?idPhoto=235959&t=1"}, "country": {"name": "France"}, "city": {"name":