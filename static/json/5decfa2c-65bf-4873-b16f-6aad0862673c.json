{"data": {"event": {"id": "5decfa2c-65bf-4873-b16f-6aad0862673c", "picture": "https://services.medicalcongress.online/congress/medias/2026/JFR2026/725/video/thumbs/poster.jpg", "sessionType": "S\u00e9ance p\u00e9dagogique", "sessionTypeColor": "#44bdfa", "voting": null, "title": "Your JFR :\u00a0Musculoskeletal oncology imaging: from quantitative MRI to reporting systems", "start": "2026-10-09T10:30+02:00", "end": "2026-10-09T12:00+02:00", "objectives": ["<div>A la fin de la s\u00e9ance, vous serez en mesure de : \u2026..<span style=\"white-space:pre\"> </span></div>", "<div>Understand how multiparametric MRI can quantitatively assess skeletal muscle in sarcopenia and translate these measurements into clinically relevant information in patients at oncologic risk<span style=\"white-space:pre\"> </span></div>", "<div>Recognize key MRI features of bone marrow tumors and tumor\u2011like lesions, and apply a pattern\u2011based approach to improve diagnosis and management decisions<span style=\"white-space:pre\"> </span></div>", "<div>Identify specific imaging patterns and pitfalls of musculoskeletal oncologic pathology in pediatrics and adolescence, including Ewing sarcoma, osteosarcoma and bone leukemia, and integrate them into age\u2011adapted care pathways.<span style=\"white-space:pre\"> </span></div>", "<div>Discuss the current status and future directions of imaging report and data systems for bone tumors, and how structured reporting can harmonize clinical practice and research in musculoskeletal oncology.<span style=\"white-space:pre\"> </span></div>"], "onAir": null, "vod": {"checkPermissions": ["media:view"], "media": null}, "broadcasts": {"items": []}, "room": {"id": "25554d0b-a773-41ee-8a5a-92070d741b5d", "name": "243", "type": "ROOM"}, "schedule": {"items": [{"id": "55dae834-f178-4d77-8706-022b4ad8f0a7", "title": "Multiparametric MRI of Skeletal Muscle in Sarcopenia: From Quantification to Clinical Relevance", "start": "2026-10-09T10:30+02:00", "end": "2026-