# Add as a separate site after confirming the hostname and inbound routing.
# This is the initial HTTP virtual host. Add HTTPS with your certificate manager
# before setting VITE_SEARCH_API_URL on the public website.
server {
    listen 80;
    listen [::]:80;
    server_name api.forcefidele.com;

    client_max_body_size 4k;
    proxy_http_version 1.1;
    proxy_connect_timeout 2s;
    proxy_read_timeout 10s;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # Overwrite, rather than append, untrusted client-supplied forwarded headers.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";

    location = /search {
        proxy_pass http://127.0.0.1:3080;
    }
    location = /healthz {
        proxy_pass http://127.0.0.1:3080;
    }
    location / {
        return 404;
    }
}
